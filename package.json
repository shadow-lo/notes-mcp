{
  "name": "notes-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI assistants search and read your local markdown notes",
  "type": "module",
  "bin": {
    "notes-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "notes",
    "obsidian"
  ],
  "author": "shadow-lo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shadow-lo/notes-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
